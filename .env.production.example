# Bhatta Manager on the live server. Copy to .env and fill in every value marked "change".
# Keep .env private (chmod 640, owned by the deploy user, group www-data) and keep a copy of it,
# with the backup password, in a password manager: a backup cannot be opened without it.

APP_NAME="Bhatta Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bhatta.example.com
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bhatta
DB_USERNAME=bhatta
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

# Email is set up by the owner in the app (Settings → Email). These are only used until then.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="kiln@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Backups (docs/07-deployment.md, step 9).
BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=change-me-to-a-long-random-password
BACKUP_DRILL_DATABASE=bhatta_restore

# Copies of the backups on the owner's Google Drive: the same two values for every kiln
# (docs/07-deployment.md, "Google Drive copies"). The owner connects their Drive in the app.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"
